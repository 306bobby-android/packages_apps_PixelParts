# PixelParts' camera provider extension is linked into libcameraservice, so
# torch strength is written from cameraserver itself.
allow cameraserver sysfs_flash_led:dir search;
allow cameraserver sysfs_flash_led:file rw_file_perms;

# The flash LEDs are reached through /sys/class/leds, which keeps the platform
# sysfs_leds label - narrowing the leds@d300 subtree to sysfs_flash_led did not
# change the directory the path traverses to get there. Without this the writes
# fail with EACCES before ever touching a node the rules above cover, which
# looks exactly like the hardware ignoring them.
allow cameraserver sysfs_leds:dir search;

# The fingerprint HAL walks this subtree at startup and reads modalias from it.
# It could before leds@d300 was narrowed from the default sysfs label.
allow hal_fingerprint_default sysfs_flash_led:dir search;
allow hal_fingerprint_default sysfs_flash_led:file r_file_perms;

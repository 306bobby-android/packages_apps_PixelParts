<!--
     A privileged app must be listed here for every privileged permission it
     requests, even when it is platform signed - AOSP's own platform signed
     apps are listed in privapp-permissions-platform.xml for the same reason.
     Without this, ro.control_privapp_permissions=enforce fails the scan and
     takes system_server down with it on a first boot.
-->
<permissions>
    <privapp-permissions package="org.evolution.pixelparts">
        <permission name="android.permission.MODIFY_PHONE_STATE"/>
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
    </privapp-permissions>
</permissions>

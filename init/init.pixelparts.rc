# hbm_mode is 0644, so a chown is enough. redbull's init.hardware.rc also does
# this in early-boot; repeated so this repo stands alone.

on property:vendor.all.modules.ready=1

    chown system system /sys/class/backlight/panel0-backlight/hbm_mode
